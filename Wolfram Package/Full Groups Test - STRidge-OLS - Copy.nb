Cell[BoxData[
 RowBox[{
  RowBox[{"ConverterParaTexto", "[", "linha_List", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"val1", ",", "val2", ",", "val3", ",", "formataDecimal"}], "}"}],
     ",", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "Fun\[CCedilla]\[ATilde]o", " ", "auxiliar", " ", "para", " ", 
       "garantir", " ", "sempre", " ", "2", " ", "casas", " ", "decimais"}], 
      ",", 
      RowBox[{"mesmo", " ", "nos", " ", "zeros"}]}], "*)"}], 
    RowBox[{
     RowBox[{
      RowBox[{"formataDecimal", "[", "n_", "]"}], ":=", 
      RowBox[{"StringReplace", "[", 
       RowBox[{
        RowBox[{"ToString", "[", 
         RowBox[{"NumberForm", "[", 
          RowBox[{
           RowBox[{"N", "[", "n", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"Infinity", ",", "2"}], "}"}]}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"\"\<.\>\"", "~~", "EndOfString"}], "->", "\"\<.00\>\""}], 
          ",", 
          RowBox[{
           RowBox[{"\"\<.\>\"", "~~", "d_", "~~", "EndOfString"}], "->", 
           RowBox[{"\"\<.\>\"", "~~", "d", "~~", "\"\<0\>\""}]}]}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "1.", " ", "Extrai", " ", "o", " ", "primeiro", " ", "valor", " ", 
       "como", " ", "est\[AAcute]"}], "*)"}], 
     RowBox[{"val1", "=", 
      RowBox[{"ToString", "[", 
       RowBox[{"linha", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "2.", " ", "Extrai", " ", "e", " ", "formata", " ", "o", " ", "segundo",
        " ", "valor", " ", "com", " ", "2", " ", "casas", " ", "decimais"}], 
      "*)"}], 
     RowBox[{"val2", "=", 
      RowBox[{"formataDecimal", "[", 
       RowBox[{"linha", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "3.", " ", "Formata", " ", "a", " ", "lista", " ", "interna", " ", 
       "unindo", " ", "com", " ", "v\[IAcute]rgulas", " ", "e", " ", 
       "englobando", " ", "com", " ", "par\[EHat]nteses"}], "*)"}], 
     RowBox[{"val3", "=", 
      RowBox[{"StringJoin", "[", 
       RowBox[{"\"\<(\>\"", ",", 
        RowBox[{"StringRiffle", "[", 
         RowBox[{
          RowBox[{"formataDecimal", "/@", 
           RowBox[{"linha", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ",", "\"\<, \>\""}], "]"}], 
        ",", "\"\<)\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Junta", " ", "tudo", " ", "no", " ", "formato", " ", "desejado"}], 
      "*)"}], 
     RowBox[{
      RowBox[{"StringTemplate", "[", "\"\<& $`1`$ & $`2`$ & $`3`$\>\"", "]"}],
       "[", 
      RowBox[{"val1", ",", "val2", ",", "val3"}], "]"}]}]}], "]"}]}]], "Input",
